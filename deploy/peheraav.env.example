# Peheraav's settings on the server (copied to /etc/peheraav.env by install.sh).
# After changing anything here: sudo systemctl restart peheraav

PEHERAAV_DATA_DIR=/var/lib/peheraav
PEHERAAV_BACKUP_DIR=/var/backups/peheraav
PEHERAAV_BACKUP_KEEP=7

PEHERAAV_PUBLIC_URL=https://YOUR-DOMAIN
PEHERAAV_SECURE_COOKIES=1

# Shown in the privacy note as whom to ask about their data.
PEHERAAV_CONTACT_EMAIL=

# Most accounts in total (0 = no cap), and per person. Keeps a small free server comfortable.
PEHERAAV_MAX_USERS=50
PEHERAAV_MAX_ITEMS=300
PEHERAAV_MAX_LOOKS=200

# Email for "forgot password". Gmail: host smtp.gmail.com, port 587, your Gmail address as user
# and MAIL_FROM, and a Google "app password" (not your normal password) as the password.
# Left empty, reset emails are only written to the log: sudo journalctl -u peheraav
PEHERAAV_SMTP_HOST=
PEHERAAV_SMTP_PORT=587
PEHERAAV_SMTP_USER=
PEHERAAV_SMTP_PASSWORD=
PEHERAAV_MAIL_FROM=

# Off-site copy of each nightly backup: Backblaze B2 (10 GB free, no card), see docs/DEPLOY.md step 9.
# Easiest: sudo bash /opt/peheraav/deploy/backup-setup.sh (fills these in). REGION is the B2 region, e.g. us-west-004.
# Without these, backups stay only on this server's disk.
PEHERAAV_BACKUP_S3_ENDPOINT=
PEHERAAV_BACKUP_S3_BUCKET=
PEHERAAV_BACKUP_S3_KEY_ID=
PEHERAAV_BACKUP_S3_SECRET=
PEHERAAV_BACKUP_S3_REGION=auto
