# Adaa's settings on the server (copied to /etc/adaa.env by install.sh).
# After changing anything here: sudo systemctl restart adaa

ADAA_DATA_DIR=/var/lib/adaa
ADAA_BACKUP_DIR=/var/backups/adaa
ADAA_BACKUP_KEEP=7

ADAA_PUBLIC_URL=https://YOUR-DOMAIN
ADAA_SECURE_COOKIES=1

# Shown in the privacy note as whom to ask about their data.
ADAA_CONTACT_EMAIL=

# Most accounts in total (0 = no cap), and per person. Keeps a small free server comfortable.
ADAA_MAX_USERS=50
ADAA_MAX_ITEMS=300
ADAA_MAX_LOOKS=200

# Email for "forgot password". Gmail: host smtp.gmail.com, port 587, your Gmail address as user
# and MAIL_FROM, and a Google "app password" (not your normal password) as the password.
# Left empty, reset emails are only written to the log: sudo journalctl -u adaa
ADAA_SMTP_HOST=
ADAA_SMTP_PORT=587
ADAA_SMTP_USER=
ADAA_SMTP_PASSWORD=
ADAA_MAIL_FROM=

# Off-site copy of each nightly backup: Backblaze B2 (10 GB free, no card), see docs/DEPLOY.md step 9.
# Easiest: sudo bash /opt/adaa/deploy/backup-setup.sh (fills these in). REGION is the B2 region, e.g. us-west-004.
# Without these, backups stay only on this server's disk.
ADAA_BACKUP_S3_ENDPOINT=
ADAA_BACKUP_S3_BUCKET=
ADAA_BACKUP_S3_KEY_ID=
ADAA_BACKUP_S3_SECRET=
ADAA_BACKUP_S3_REGION=auto
